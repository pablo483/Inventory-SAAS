# =============================================================================
# Terraform Variable Values - Example / Template
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars with real secrets to version control.
# =============================================================================

project_name = "inventory-saas"
environment  = "production"
aws_region   = "us-east-1"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# Database
db_instance_class = "db.t3.micro"
db_name           = "inventory_db"
db_username       = "dbadmin"
db_password       = "CHANGE_ME_TO_A_SECURE_PASSWORD"

# ECS - Backend (Java Spring Boot)
backend_image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/inventory-backend:latest"
backend_port          = 8080
backend_cpu           = 512
backend_memory        = 1024
backend_desired_count = 1

# ECS - Frontend (React)
frontend_image         = "123456789012.dkr.ecr.us-east-1.amazonaws.com/inventory-frontend:latest"
frontend_port          = 3000
frontend_cpu           = 256
frontend_memory        = 512
frontend_desired_count = 1
